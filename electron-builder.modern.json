{
  "appId": "com.localpdfeditor.app",
  "productName": "JumiPDF",
  "afterPack": "build/after-pack.cjs",
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "tools/qpdf",
      "to": "qpdf",
      "filter": [
        "**/*"
      ]
    }
  ],
  "directories": {
    "output": "release/modern"
  },
  "win": {
    "target": "nsis",
    "icon": "build/app-icon.ico",
    "signAndEditExecutable": false,
    "artifactName": "${productName} Setup ${version} Windows 10-11 ${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  }
}
