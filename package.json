{
  "name": "local-pdf-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .",
    "build": "tsc && vite build",
    "dist": "npm run dist:modern",
    "dist:modern": "npm run build && electron-builder --config electron-builder.modern.json --win nsis --x64",
    "dist:legacy": "npm run build && electron-builder --config electron-builder.legacy.json --win nsis --x64",
    "dist:legacy:ia32": "npm run build && electron-builder --config electron-builder.legacy.json --win nsis --ia32",
    "dist:all": "npm run dist:modern && npm run dist:legacy",
    "pack": "npm run pack:modern",
    "pack:modern": "npm run build && electron-builder --config electron-builder.modern.json --dir --x64",
    "pack:legacy": "npm run build && electron-builder --config electron-builder.legacy.json --dir --x64",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "vitest": "^2.1.8"
  }
}
